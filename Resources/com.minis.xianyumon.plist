<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 主城市 -->
    <key>city</key>
    <string>长沙</string>

    <!-- 城市别名（含区名，卖家常只写区不写市）-->
    <key>cityAliases</key>
    <array>
        <string>长沙</string>
        <string>岳麓</string>
        <string>雨花</string>
        <string>天心</string>
        <string>芙蓉</string>
        <string>开福</string>
        <string>望城</string>
        <string>星沙</string>
        <string>宁乡</string>
        <string>浏阳</string>
    </array>

    <!-- 想要人数门槛：>= 这个数就通知 -->
    <key>minWant</key>
    <integer>3</integer>

    <!-- 关键词：留空数组 = 不限制；填了就只通知标题含关键词的 -->
    <key>keywords</key>
    <array/>
</dict>
</plist>
